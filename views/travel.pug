extends ./layouts/index

block content
  main.container.mt-5
    .row 
      .col-md-5 
        img(src=`/img/destinos_${viaje.imagen}_ln.jpg`, alt="Viaje", class="img-fluid")
      .col-md-7 
        h1.mt-5.text-center= viaje.titulo
        p 
          svg(xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewbox='0 0 24 24' fill='none' stroke='#d4607f' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
            path(d='M4 7a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-12')
            path(d='M16 3v4')
            path(d='M8 3v4')
            path(d='M4 11h16')
            path(d='M11 15h1')
            path(d='M12 15v3')
          = `Ida: ${viaje.fecha_ida} / Regreso: ${viaje.fecha_vuelta}`
        p
          svg(xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewbox='0 0 24 24' fill='none' stroke='#d4607f' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
            path(d='M10 13a2 2 0 1 0 4 0a2 2 0 0 0 -4 0')
            path(d='M8 21v-1a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v1')
            path(d='M15 5a2 2 0 1 0 4 0a2 2 0 0 0 -4 0')
            path(d='M17 10h2a2 2 0 0 1 2 2v1')
            path(d='M5 5a2 2 0 1 0 4 0a2 2 0 0 0 -4 0')
            path(d='M3 13v-1a2 2 0 0 1 2 -2h2')

          = `${viaje.disponibles} Disponibles`
        
        p 
          svg(xmlns='http://www.w3.org/2000/svg' width='24' height='24' viewbox='0 0 24 24' fill='none' stroke='#d4607f' stroke-width='2' stroke-linecap='round' stroke-linejoin='round')
            path(d='M16.7 8a3 3 0 0 0 -2.7 -2h-4a3 3 0 0 0 0 6h4a3 3 0 0 1 0 6h-4a3 3 0 0 1 -2.7 -2')
            path(d='M12 3v3m0 12v3')
          = `${viaje.precio} USD`

        p= viaje.descripcion
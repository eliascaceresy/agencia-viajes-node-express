extends ./layouts/index

block content
  main.container.mt-5 
    h1.text-center.mt-5= page
    blockquote.text-center Lee sobre nuestros clientes y sus experiencias...
    .row.testimoniales
      each testimony in testimonies 
        .col-md-6.col-lg-4.mb-4
          .card
            .card-body
              blockquote.blockquote 
              p.mb-0
                = testimony.mensaje
              footer.blockquote-footer 
                = testimony.nombre
    .row
      h2.d-block.w-100.text-center Agregar Tertimonio 
      .row.justify-content-center.col
        .col-md-8 
          if error 
            p.alert.alert-danger= error
          else if success 
            p.alert.alert-success= success
          form(action="/testimonies" method="POST")
            .form-group 
              label(form="nombre") Nombre
              input#nombre(type="text", placeholder="Tu nombre", name="nombre", class="form-control", value= nombre) 
            .form-group 
              label(form="email") Email
              input#email(type="text", placeholder="Tu email", name="email", class="form-control", value= email)
            .form-group 
              label(form="mensaje") Cuentanos tu experiencia...
              textarea#mensaje(placeholder="Cuéntanos tu experiencia...", name="mensaje", class="form-control", rows=3)= mensaje 
            
            input.btn.btn-success.btn-block(type="submit")